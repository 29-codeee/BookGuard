# Copy to backend/.env and fill in. Never commit backend/.env (it is git-ignored).

# --- Server ---
PORT=3001
NODE_ENV=development
CORS_ORIGIN=*
DEFAULT_HOLD_TTL_SECONDS=600
DEMO_HOLD_TTL_SECONDS=15

# --- Data stores ---
# Leave these commented (default) to use embedded PGlite + an in-memory TTL store:
# zero external dependencies, good for quick local dev.
#
# Uncomment them to use the real Postgres + Redis from docker-compose.yml instead.
# This matters for the concurrency demo: PGlite is genuine Postgres semantics but
# runs as a single in-process connection, so it doesn't exercise real
# multi-connection pool contention the way a networked Postgres server does.
#
#   docker compose up -d postgres redis
#   cd backend && npm run dev
#
# DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/bookguard
# REDIS_URL=redis://localhost:6379

# --- AI Travel Planner ---
# Enables LLM understanding in the chatbot. Leave empty to run in offline demo mode.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5)
# CHAT_AI_MODEL=claude-opus-5
# Set to "demo" to force the offline demo extractor even when a key is present
# CHAT_AI_MODE=demo
# Traveller account used for demo booking requests created from the chat
# CHAT_DEMO_TRAVELLER_ID=traveller_priya
