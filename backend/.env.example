# Copy to backend/.env and fill in. Never commit backend/.env (it is git-ignored).

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Data stores (optional: without them the backend uses embedded PGlite + an in-memory TTL store) ---
# DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/bookguard
# REDIS_URL=redis://localhost:6379

# --- AI Travel Planner ---
# Enables LLM understanding in the chatbot. Leave empty to run in offline demo mode.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5)
# CHAT_AI_MODEL=claude-opus-5
# Set to "demo" to force the offline demo extractor even when a key is present
# CHAT_AI_MODE=demo
# Traveller account used for demo booking requests created from the chat
# CHAT_DEMO_TRAVELLER_ID=traveller_priya
