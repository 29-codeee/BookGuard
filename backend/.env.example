# Copy this file to backend/.env to point the backend at the real Postgres + Redis
# from docker-compose.yml instead of the embedded PGlite/in-memory fallback.
# This matters for the concurrency demo: PGlite is genuine Postgres semantics but
# runs as a single in-process connection, so it doesn't exercise real multi-connection
# pool contention the way a networked Postgres server does.
#
#   docker compose up -d postgres redis
#   cp backend/.env.example backend/.env
#   cd backend && npm run dev
#
# Leaving backend/.env absent (default) falls back to embedded PGlite + in-memory
# Redis — zero external dependencies, good for quick local dev.
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/bookguard
REDIS_URL=redis://localhost:6379

PORT=3001
NODE_ENV=development
CORS_ORIGIN=*
DEFAULT_HOLD_TTL_SECONDS=600
DEMO_HOLD_TTL_SECONDS=15
