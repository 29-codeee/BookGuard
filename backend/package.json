{
  "name": "bookguard-backend",
  "version": "1.0.0",
  "description": "BookGuard Backend - Fastify + TypeScript + PostgreSQL + Redis",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --import tsx --test --test-force-exit --test-concurrency=1 src/tests/*.test.ts",
    "test:concurrency": "tsx src/tests/concurrency.ts",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:seed": "prisma db seed",
    "start:mock": "tsx src/providers/mockServer.ts",
    "experiments": "tsx src/scripts/runExperiments.ts",
    "evaluate": "tsx src/scripts/evaluateExperiments.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@electric-sql/pglite": "^0.2.14",
    "@fastify/cors": "^10.0.1",
    "@prisma/client": "^6.19.3",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  }
}
