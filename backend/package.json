{
  "name": "bookguard-backend",
  "version": "1.0.0",
  "description": "BookGuard Backend - Fastify + TypeScript + PostgreSQL + Redis",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --import tsx --test --test-force-exit --test-concurrency=1 src/tests/*.test.ts",
    "test:concurrency": "tsx src/tests/concurrency.ts",
    "start:mock": "tsx src/providers/mockServer.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@electric-sql/pglite": "^0.2.14",
    "@fastify/cors": "^10.0.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
